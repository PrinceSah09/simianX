# Environment variable example file
# Copy this to .env and fill in real values.
# NEVER commit the real .env file to version control.

# Application settings
APP_NAME="SimianX"
APP_VERSION="0.1.0"
DEBUG=true

# Server settings (used by Uvicorn when starting locally)
HOST="0.0.0.0"
PORT=8000

# Slack Alerting Integration (Paste your Slack Incoming Webhook URL here)
# SLACK_WEBHOOK_URL="https://hooks.slack.com/services/YOUR_WORKSPACE_ID/YOUR_CHANNEL_ID/YOUR_WEBHOOK_TOKEN"
SLACK_CHANNEL="#sre-alerts"
SLACK_ALERTS_ENABLED=true
ALERT_COOLDOWN_SECONDS=60
ALERT_ERROR_THRESHOLD_PCT=5.0
ALERT_LATENCY_THRESHOLD_MS=250.0
