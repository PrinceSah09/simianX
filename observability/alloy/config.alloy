// ============================================================================
// Grafana Alloy Configuration for SimianX SRE Resilience Platform
// Collects OpenTelemetry OTLP Traces & Metrics and forwards to Tempo & Prometheus
// ============================================================================

otelcol.receiver.otlp "default" {
  http {
    endpoint = "0.0.0.0:4318"
  }
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  output {
    traces  = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  timeout         = "1s"
  send_batch_size = 256

  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}

// Scrape SimianX Backend Prometheus metrics endpoint
prometheus.scrape "simianx" {
  targets = [
    {"__address__" = "simianx-backend:8000"},
  ]
  metrics_path    = "/metrics"
  scrape_interval = "2s"
  scrape_timeout  = "2s"
  forward_to      = [prometheus.remote_write.default.receiver]
}

prometheus.remote_write "default" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

